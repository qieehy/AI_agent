# ====== LLM 凭据（必填，从服务商控制台获取） ======
API_KEY="your-api-key-here"
BASE_URL_CHAT="https://api.openai.com/v1"
MODEL="gpt-4o-mini"

# ====== Runtime 配置 ======
MAX_STEPS=100
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ====== Memory 配置 ======
MAX_TOKENS=8000
SUMMARY_THRESHOLD=0.8
SESSIONS_DIR=./sessions

# ====== 日志 ======
LOG_LEVEL=INFO
LOG_FORMAT=json

# ====== 可观测性（可选） ======
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
