# ====== LLM 凭据（必填，从服务商控制台获取） ======
API_KEY="your-api-key-here"
BASE_URL="https://api.openai.com/v1"
MODEL="gpt-4o-mini"

# ====== Runtime 配置 ======
MAX_STEPS=100
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ====== Embedding-only Tool Router ======
TOOL_ROUTER_MODEL="BAAI/bge-small-zh-v1.5"
TOOL_ROUTER_THRESHOLD=0.35
TOOL_ROUTER_TOP_K=3
TOOL_ROUTER_CACHE_SIZE=256
TOOL_ROUTER_MAX_QUERY_CHARS=4096
TOOL_ROUTER_WORKER_STARTUP_TIMEOUT_S=180
TOOL_ROUTER_WORKER_INFERENCE_TIMEOUT_S=30
TOOL_ROUTER_WORKER_LOCK_TIMEOUT_S=5
TOOL_ROUTER_WORKER_SHUTDOWN_TIMEOUT_S=5
TOOL_ROUTER_WORKER_MAX_REQUEST_BYTES=262144
TOOL_ROUTER_WORKER_MAX_RESPONSE_BYTES=4194304
TOOL_ROUTER_WORKER_MAX_STDERR_CHARS=4096

# ====== Planner Agent（仅 plan_execute 模式启用） ======
PLANNER_TIMEOUT_S=30
PLANNER_MAX_TASKS=12
PLANNER_MAX_GOAL_CHARS=1000

# ====== Memory 配置 ======
MAX_TOKENS=8000
SUMMARY_THRESHOLD=0.8
SESSIONS_DIR=./sessions

# ====== 日志 ======
LOG_LEVEL=INFO
LOG_FORMAT=json

# ====== 可观测性（可选） ======
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
